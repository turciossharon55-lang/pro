<% @posts.each do |x| %>
  <div>
    <%= image_tag x.image.url(:medium) %>
    <br>
    <%= x.description %>
    <div class="link">
      <% if current_user == x.user %>
        <%= button_to "Destroy", x, method: :delete, class: "btn btn-link", form: { style: "display:inline", onsubmit: "return confirm('Are you sure?')" } %>
        <%= link_to "Edit", edit_post_path(x) %>
      <% end %>
      <%= link_to "Show", x %>
    </div>
  </div>
<% end %>
